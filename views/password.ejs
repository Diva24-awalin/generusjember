<!doctype html><html lang="id"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ganti Password - SIGJ</title><link rel="stylesheet" href="/style.css"></head>
<body><div class="wrap">
  <a class="back" href="/admin">Kembali</a>
  <h1>Akun Admin</h1>
  <p class="muted">Masuk sebagai <b><%= admin.email %></b></p>

  <% if (pesan) { %><p class="<%= ok ? 'ok' : 'err' %>"><b><%= pesan %></b></p><% } %>

  <form class="card" method="post" action="/admin/password">
    <h2>Ganti Password</h2>
    <label>Password lama</label><input type="password" name="lama" required>
    <label>Password baru (minimal 8 karakter)</label><input type="password" name="baru" required minlength="8">
    <label>Ulangi password baru</label><input type="password" name="ulang" required minlength="8">
    <p><button class="btn-block">Simpan Password</button></p>
  </form>

  <form class="card" method="post" action="/admin/admin-baru">
    <h2>Tambah Admin Baru</h2>
    <label>Email</label><input type="email" name="email" required>
    <label>Password (minimal 8 karakter)</label><input type="password" name="password" required minlength="8">
    <p><button class="btn-block">Tambah Admin</button></p>
    <p class="muted" style="font-size:13px">Admin saat ini:</p>
    <ul class="muted" style="margin:0;padding-left:18px">
      <% admins.forEach(a => { %><li><%= a.email %></li><% }) %>
    </ul>
  </form>
</div></body></html>
