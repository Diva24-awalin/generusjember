<!doctype html><html lang="id"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Beranda - SIGJ</title><link rel="stylesheet" href="/style.css"></head>
<body><div class="wrap wide">

  <div class="hello">
    <div>
      <small>Selamat datang,</small>
      <h1>Pengurus SIGJ</h1>
      <p class="muted" style="margin:0"><%= admin.email %> · <%= tanggalHariIni %></p>
    </div>
    <img class="brand-logo" src="/logo.png" alt="" onerror="this.style.display='none'">
  </div>

    <div id="boxPengumuman"></div>
  <script>
  fetch('/admin/pengumuman/aktif.json').then(r => r.json()).then(list => {
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    document.getElementById('boxPengumuman').innerHTML = list.map(p =>
      '<div class="ann"><div class="ann-ic">📢</div><div class="ann-body">' +
      '<b>' + esc(p.judul) + '</b>' +
      '<small class="muted">' + esc(p.target) + (p.sampai ? ' · sampai ' + esc(p.sampai) : '') + '</small>' +
      (p.isi ? '<p>' + esc(p.isi) + '</p>' : '') +
      (p.ada_foto ? '<img class="pg-foto" src="/admin/pengumuman/' + Number(p.id) + '/foto" alt="">' : '') +
      '</div></div>').join('');
  }).catch(() => {});
  </script>
  
  <div class="cards2">
    <a class="mcard hero" href="/admin/generus"><span>Muda-mudi</span><b><%= total %></b><small>Terdaftar</small></a>
    <a class="mcard" href="/admin/wilayah"><span>Desa</span><b><%= desaN %></b><small>Dalam daerah</small></a>
    <a class="mcard" href="/admin/wilayah"><span>Kelompok</span><b><%= kelompokN %></b><small>Dalam daerah</small></a>
    <a class="mcard" href="/admin/rekap"><span>Kehadiran</span><b><%= persen30 %>%</b><small>30 hari terakhir</small></a>
  </div>

  <div class="quick">
    <a class="qi-wrap" href="/admin/absen"><span class="qi q-teal"><%- ic('check', 24) %></span>Absen</a>
    <a class="qi-wrap" href="/admin/generus"><span class="qi q-sky"><%- ic('users', 24) %></span>Mumi</a>
    <a class="qi-wrap" href="/admin/kegiatan"><span class="qi q-amber"><%- ic('calendar', 24) %></span>Kegiatan</a>
    <a class="qi-wrap" href="/admin/rekap"><span class="qi q-green"><%- ic('chart', 24) %></span>Rekap</a>
    <a class="qi-wrap" href="/admin/jurnal"><span class="qi q-violet"><%- ic('book', 24) %></span>Jurnal</a>
    <a class="qi-wrap" href="/admin/wilayah"><span class="qi q-rose"><%- ic('pin', 24) %></span>Wilayah</a>
    <a class="qi-wrap" href="#" id="btnLainnya"><span class="qi q-slate"><%- ic('grid', 24) %></span>Lainnya</a>
  </div>

    <!-- Kegiatan hari ini -->
  <div class="card">
    <div class="sec-head">
      <h2>Kegiatan hari ini</h2>
      <a class="pill-link" href="/admin/absen">Lihat Semua ›</a>
    </div>

    <% if (!hariIni.length) { %>
    <div class="empty">
      <div class="empty-ic"><%- ic('calendar', 30) %></div>
      <b>Belum ada kegiatan hari ini</b>
      <p class="muted">Buat kegiatan baru untuk mulai absensi dengan QR.</p>
      <a class="btn btn-sm" href="/admin/kegiatan"><%- ic('plus', 16) %> Buat Kegiatan</a>
    </div>
    <% } %>

    <% hariIni.forEach(k => {
         const p = total ? Math.min(100, Math.round(k.hadir * 100 / total)) : 0;
         const t = tglID(k.tgl).split(' '); %>
    <a class="kcard today" href="/admin/kegiatan/<%= k.id %>">
      <div class="dblock"><b><%= t[0] %></b><span><%= t[1] %></span></div>
      <div class="kcard-body">
        <div class="kcard-top">
          <b class="kcard-name"><%= k.nama %></b>
          <span class="badge <%= k.buka ? 'on' : 'off' %>"><%= k.label %></span>
        </div>
        <div class="chips2">
          <span class="chip2 c-h">Hadir <%= k.hadir %></span>
          <span class="chip2 c-i">Izin <%= k.izin %></span>
        </div>
        <div class="bar thin"><i class="c-hadir" style="width:<%= p %>%"></i></div>
        <small class="muted"><%= p %>% dari <%= total %> muda-mudi</small>
      </div>
    </a>
    <% }) %>
  </div>

  <!-- Kegiatan terbaru -->
  <div class="card">
    <div class="sec-head">
      <h2>Kegiatan terbaru</h2>
      <a class="pill-link" href="/admin/kegiatan">Semua ›</a>
    </div>

    <% if (!terbaru.length) { %>
    <div class="empty">
      <div class="empty-ic"><%- ic('calendar', 30) %></div>
      <b>Belum ada kegiatan</b>
      <a class="btn btn-sm" href="/admin/kegiatan"><%- ic('plus', 16) %> Buat Kegiatan</a>
    </div>
    <% } %>

    <% terbaru.forEach(k => {
         const t = tglID(k.tgl).split(' '); %>
    <a class="kcard" href="/admin/kegiatan/<%= k.id %>">
      <div class="dblock soft"><b><%= t[0] %></b><span><%= t[1] %></span></div>
      <div class="kcard-body">
        <div class="kcard-top">
          <b class="kcard-name"><%= k.nama %></b>
          <span class="badge <%= k.buka ? 'on' : 'off' %>"><%= k.label %></span>
        </div>
        <div class="chips2">
          <span class="chip2 c-h">Hadir <%= k.hadir %></span>
          <span class="chip2 c-i">Izin <%= k.izin %></span>
          <span class="chip2 c-y"><%= t[2] %></span>
        </div>
      </div>
      <span class="chev">›</span>
    </a>
    <% }) %>
  </div>
    <div class="sheet-back" id="sheetBack"></div>
  <div class="sheet" id="sheet">
    <div class="sheet-handle"></div>
    <h2 style="margin:6px 0 14px">Menu Lainnya</h2>
    <div class="quick" style="box-shadow:none;border:0;padding:0;margin:0">
      <a class="qi-wrap" href="/admin/rekap-generus"><span class="qi q-teal"><%- ic('users', 24) %></span>Rekap Generus</a>
      <a class="qi-wrap" href="/admin/perlu-perhatian"><span class="qi q-rose"><%- ic('alert', 24) %></span>Perlu Perhatian</a>
      <a class="qi-wrap" href="/admin/pengumuman"><span class="qi q-amber"><%- ic('megaphone', 24) %></span>Pengumuman</a>
      <a class="qi-wrap" href="/admin/template-wa"><span class="qi q-green"><%- ic('chat', 24) %></span>Template WA</a>
      <a class="qi-wrap" href="/admin/notif"><span class="qi q-sky"><%- ic('bell', 24) %></span>Notifikasi</a>
      <a class="qi-wrap" href="/admin/generus/export"><span class="qi q-blue"><%- ic('download', 24) %></span>Export Data</a>
      <a class="qi-wrap" href="/admin/log"><span class="qi q-violet"><%- ic('history', 24) %></span>Log Aktivitas</a>
      <a class="qi-wrap" href="/admin/profil"><span class="qi q-slate"><%- ic('user', 24) %></span>Akun</a>
    </div>
  </div>
  <script>
  (function () {
    var s = document.getElementById('sheet'), b = document.getElementById('sheetBack');
    function buka() { s.classList.add('open'); b.classList.add('open'); }
    function tutup() { s.classList.remove('open'); b.classList.remove('open'); }
    document.getElementById('btnLainnya').onclick = function (e) { e.preventDefault(); buka(); };
    b.onclick = tutup;
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') tutup(); });
  })();
  </script>
</div></body></html>