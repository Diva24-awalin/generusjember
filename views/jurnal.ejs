<!doctype html><html lang="id"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Jurnal - SIGJ</title><link rel="stylesheet" href="/style.css"></head>
<body><div class="wrap wide">
  <p class="muted" style="margin-top:0">Simpan materi dan catatan kegiatan. Unggah file (maks. 4 MB) atau tempel link.</p>
  <% if (pesan) { %><p class="<%= ok ? 'ok' : 'err' %>"><b><%= pesan %></b></p><% } %>

  <details class="card" <%= (pesan && !ok) ? 'open' : '' %>>
    <summary>+ Tambah Jurnal / Materi</summary>
    <form method="post" action="/admin/jurnal" enctype="multipart/form-data">
      <label>Judul</label><input name="judul" required maxlength="150" placeholder="Contoh: Materi Pengajian Akhir Tahun">
      <label>Tanggal</label><input type="date" name="tanggal" value="<%= hariIni %>">
      <label>Kegiatan terkait (opsional)</label>
      <select name="kegiatan_id">
        <option value="">Tidak terkait kegiatan</option>
        <% keg.forEach(k => { %><option value="<%= k.id %>"><%= k.nama %> (<%= tglID(k.tgl) %>)</option><% }) %>
      </select>
      <label>Catatan</label><textarea name="isi" rows="4" maxlength="2000" placeholder="Ringkasan materi, poin penting, dan lain-lain"></textarea>
      <label>Link materi (opsional)</label><input name="link" placeholder="https://drive.google.com/...">
      <label>Upload file (opsional, maks. 4 MB)</label>
      <input type="file" name="berkas" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt">
      <p class="muted" style="font-size:13px">Jenis file: PDF, gambar, Word, PowerPoint, Excel, TXT.</p>
      <p><button class="btn-block">Simpan Jurnal</button></p>
    </form>
  </details>

  <h2 style="margin:18px 0 10px">Daftar Jurnal (<%= list.length %>)</h2>
  <% if (!list.length) { %><div class="card muted">Belum ada jurnal.</div><% } %>
  <% list.forEach(j => { %>
  <div class="card">
    <b><%= j.judul %></b><br>
    <small class="muted"><%= tglID(j.tgl) %><% if (j.kegiatan) { %> · <%= j.kegiatan %><% } %> · oleh <%= j.dibuat_oleh || '-' %></small>
    <% if (j.isi) { %><p style="white-space:pre-wrap;margin:10px 0 0"><%= j.isi %></p><% } %>
    <div class="actions" style="margin-top:12px;flex-wrap:wrap">
      <% if (j.ada_file) { %><a class="btn btn-sm" target="_blank" rel="noopener" href="/admin/jurnal/<%= j.id %>/file"><%- ic('file', 15) %> <%= j.file_nama %></a><% } %>
      <% if (j.link) { %><a class="btn btn-line btn-sm" target="_blank" rel="noopener" href="<%= j.link %>"><%- ic('link', 15) %> Buka Link</a><% } %>
      <form class="inline" method="post" action="/admin/jurnal/<%= j.id %>/hapus"
            onsubmit="return confirm('Hapus jurnal ini beserta filenya?')">
        <button class="btn-danger btn-sm">Hapus</button>
      </form>
    </div>
  </div>
  <% }) %>
</div></body></html>